# ---------------------------------------------------------------
# QueryDeck — environment configuration
# Copy to .env and adjust. NEVER commit your real .env file.
# ---------------------------------------------------------------

APP_NAME="QueryDeck"
APP_ENV=production            # production | development
APP_DEBUG=false               # true only in development (shows stack traces)
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Lisbon
APP_LOCALE=pt

# 32-byte key, base64 encoded. Used to encrypt external DB credentials.
# Generate with:  php bin/console key:generate
# WARNING: changing this key makes stored connection passwords unreadable.
APP_KEY=

# ---------------------------------------------------------------
# Application database (QueryDeck's OWN metadata: users, saved
# connections, queries, history, reports...). This is NOT one of the
# external databases you connect to in order to run queries.
# ---------------------------------------------------------------
APP_DB_DRIVER=mysql           # mysql | sqlite
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_DATABASE=querydeck
APP_DB_USERNAME=querydeck
APP_DB_PASSWORD=
# Only used when APP_DB_DRIVER=sqlite (relative to project root or absolute)
APP_DB_SQLITE_PATH=storage/sqlite/querydeck.sqlite

# ---------------------------------------------------------------
# Initial / test account (created by: php bin/console db:seed)
# Change the password after the first login.
# ---------------------------------------------------------------
TEST_USER_NAME="Administrator"
TEST_USER_EMAIL=admin@example.com
TEST_USER_PASSWORD=change-me

# ---------------------------------------------------------------
# Sessions & security
# ---------------------------------------------------------------
SESSION_NAME=querydeck_sid
SESSION_LIFETIME=7200         # idle timeout in seconds
SESSION_SECURE_COOKIE=auto    # auto | true | false
LOGIN_MAX_ATTEMPTS=5          # per email+IP, within LOGIN_LOCKOUT_SECONDS
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------
# Query execution limits (external databases)
# ---------------------------------------------------------------
QUERY_TIMEOUT_SECONDS=60      # statement timeout sent to the server
QUERY_MAX_ROWS=10000          # max rows kept per result set for browsing
QUERY_PAGE_SIZE=100           # default rows per page in the grid
EXPORT_MAX_ROWS=0             # 0 = unlimited (exports are streamed)
RESULT_CACHE_TTL=3600         # seconds a result set stays cached server-side
HISTORY_RETENTION_DAYS=180

# ---------------------------------------------------------------
# AI assistant — any OpenAI-compatible API (Open WebUI, Ollama, LM Studio...)
# Open WebUI: AI_BASE_URL=http://localhost:3000/api and create an API key in
#             Open WebUI → Settings → Account → API Keys
# Ollama:     AI_BASE_URL=http://localhost:11434/v1 (no key)
# Generated SQL is ALWAYS executed read-only.
# ---------------------------------------------------------------
AI_ENABLED=false
AI_BASE_URL=http://localhost:3000/api
AI_API_KEY=
AI_MODEL=qwen2.5-coder:14b
AI_TIMEOUT_SECONDS=120
AI_TEMPERATURE=0.1
AI_MAX_ATTEMPTS=3
AI_SEND_RESULTS=true          # false = the model never sees result data, only the schema
AI_RESULT_ROWS=50
AI_QUERY_MAX_ROWS=1000
AI_SCHEMA_MAX_TABLES=150
